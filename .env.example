# ------------------------------------------------------------------
# AI Real Estate Sales Employee — environment variables
# Copy to `.env` and replace placeholders. Never commit real values.
# ------------------------------------------------------------------

# --- Runtime ---
NODE_ENV=development

# --- PostgreSQL (docker-compose uses these too) ---
POSTGRES_USER=realestate
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=realestate_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://realestate:change-me-local-only@localhost:5432/realestate_dev?schema=public

# --- API ---
API_PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the API (for correct client IPs in rate limiting). 0 = none.
TRUST_PROXY_HOPS=0
# Public URL of the web app (used to build invitation links)
WEB_APP_URL=http://localhost:3000

# --- Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ---
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Set true in production (HTTPS). Must be false for plain http://localhost.
COOKIE_SECURE=false
# Optional cookie domain, e.g. .example.com. Leave empty for host-only cookies.
COOKIE_DOMAIN=

# --- Rate limiting ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# --- Invitations ---
INVITATION_TTL_HOURS=72
# Email delivery is not configured in Phase 1; the API always reports delivery as "not_sent".
#   dev_link -> (non-production only) the accept link is returned once to the inviter so it can be shared manually
#   none     -> no link is returned
INVITATION_DELIVERY=dev_link

# --- AI employee ---
#   fake      -> offline, rule-based replies. No key needed. Good for demos and tests.
#   anthropic -> Claude. Get a key at https://console.anthropic.com
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 (best quality) or claude-haiku-5-5 (cheaper, faster)
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_MS=30000
AI_HISTORY_MESSAGES=20

# --- Secrets stored in the database ---
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts WhatsApp access tokens.
# Required in production. In development a key is derived from JWT_ACCESS_SECRET if empty.
# Changing it later means every business must reconnect WhatsApp.
DATA_ENCRYPTION_KEY=

# --- WhatsApp (Meta Cloud API) ---
#   fake  -> demo mode: messages are recorded in the inbox but never sent. Includes a simulator.
#   cloud -> real WhatsApp through Meta. Needs the two secrets below. See docs/setup-guide.md.
WHATSAPP_PROVIDER=fake
# Meta app → App settings → Basic → App secret. Every webhook is verified with it.
WHATSAPP_APP_SECRET=
# Any long random string (16+ chars). Enter the same value in the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_TIMEOUT_MS=15000
# Wait this long after a buyer message before replying, so a burst of messages gets one answer.
WHATSAPP_REPLY_DEBOUNCE_MS=2500

# --- Email (password resets, verification, invitations) ---
# Demo requests from the public Contact page are emailed here (optional; always stored).
CONTACT_NOTIFICATION_EMAIL=
#   fake   -> development: emails (with their links) are printed in the API log
#   resend -> real email via https://resend.com (required in production)
MAIL_PROVIDER=fake
RESEND_API_KEY=
# The sending domain must be verified in Resend.
MAIL_FROM="AI Real Estate Sales Employee <noreply@example.com>"
MAIL_REPLY_TO=
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFICATION_TTL_HOURS=48

# --- Site visits ---
# WhatsApp reminder this many minutes before a confirmed visit (15–1440).
SITE_VISIT_REMINDER_MINUTES=180
# How often to look for due reminders (ms). 0 turns reminders off.
SITE_VISIT_REMINDER_INTERVAL_MS=60000

# --- Business data ---
# Days between an owner asking to delete their business and the permanent purge (1–90).
TENANT_DELETION_GRACE_DAYS=30
# How often to purge businesses past their deletion date (ms). 0 turns it off.
TENANT_PURGE_INTERVAL_MS=3600000

# --- Error tracking (optional) ---
# Sentry project DSN for the API. Leave empty to disable. Buyer messages, phone numbers,
# request bodies, cookies and auth headers are stripped before anything is sent.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# --- Web (Next.js) ---
# Public address of the marketing site. Canonical links, the sitemap and social previews use it.
# MUST be the real domain in production (e.g. https://www.yourbrand.in).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: the content of Google Search Console's "HTML tag" verification.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Browser-facing API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
