// ---------------------------------------------------------------------------
// AI Real Estate Sales Employee — Phase 1 schema (foundation)
//
// Conventions
// - UUID primary keys generated by PostgreSQL (gen_random_uuid()).
// - snake_case table and column names; camelCase in TypeScript.
// - Every tenant-owned table carries `tenant_id` and is indexed on it.
// - Foreign keys use ON DELETE RESTRICT: business data is never cascade-deleted.
//   Removing a tenant or user requires an explicit deletion process (future phase).
// ---------------------------------------------------------------------------

generator client {
  provider     = "prisma-client"
  // Generated into the API source tree (git-ignored). Regenerate with `pnpm db:generate`.
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// Connection URL is supplied by apps/api/prisma.config.ts (DATABASE_URL).
datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum BusinessType {
  BROKERAGE
  REAL_ESTATE_AGENCY
  BUILDER
  DEVELOPER
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  SALES_AGENT
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

/// A business using the platform. Root of tenant isolation.
model Tenant {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String       @db.VarChar(120)
  slug      String       @unique @db.VarChar(80)
  /// PENDING until onboarding is completed, then ACTIVE. SUSPENDED blocks all access.
  status    TenantStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  businessProfile BusinessProfile?
  settings        TenantSettings?
  memberships     Membership[]
  invitations     Invitation[]
  auditLogs       AuditLog[]
  refreshSessions RefreshSession[]
  properties      Property[]
  leads           Lead[]
  conversations   Conversation[]
  messages        Message[]
  whatsAppAccount WhatsAppAccount?
  siteVisits      SiteVisit[]

  @@map("tenants")
}

/// Public-facing business details. One per tenant.
model BusinessProfile {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String       @unique @map("tenant_id") @db.Uuid
  businessType BusinessType @map("business_type")
  phone        String?      @db.VarChar(20)
  website      String?      @db.VarChar(255)
  city         String?      @db.VarChar(100)
  state        String?      @db.VarChar(100)
  /// ISO 3166-1 alpha-2 country code.
  country      String       @default("IN") @db.Char(2)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("business_profiles")
}

/// A person who can sign in. Users are global; access to a tenant comes from a Membership.
model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String     @db.VarChar(120)
  /// Stored lower-cased and trimmed.
  email        String     @unique @db.VarChar(254)
  /// Argon2id hash. Never returned by the API.
  passwordHash String     @map("password_hash") @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships               Membership[]
  refreshSessions           RefreshSession[]
  invitationsCreated        Invitation[]      @relation("InvitationInvitedBy")
  auditLogs                 AuditLog[]
  propertiesCreated         Property[]        @relation("PropertyCreatedBy")
  leadsCreated              Lead[]            @relation("LeadCreatedBy")
  conversationsStarted      Conversation[]    @relation("ConversationCreatedBy")
  whatsAppAccountsConnected WhatsAppAccount[] @relation("WhatsAppAccountConnectedBy")
  siteVisitsCreated         SiteVisit[]       @relation("SiteVisitCreatedBy")

  @@map("users")
}

/// Grants a user a role inside a tenant.
model Membership {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      MembershipRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  assignedLeads      Lead[]      @relation("LeadAssignedTo")
  assignedSiteVisits SiteVisit[] @relation("SiteVisitAssignedTo")

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, role])
  @@map("memberships")
}

/// Pending invitation for an email address to join a tenant. Only the token hash is stored.
model Invitation {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  email       String         @db.VarChar(254)
  role        MembershipRole
  /// SHA-256 of the random invitation token (hex).
  tokenHash   String         @unique @map("token_hash") @db.Char(64)
  invitedById String?        @map("invited_by_id") @db.Uuid
  expiresAt   DateTime       @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime?      @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime?      @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitedBy User?  @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([tenantId, email])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("invitations")
}

/// A refresh-token session. Tokens rotate on every use; sessions in the same `familyId`
/// descend from one login, so reuse of a rotated token revokes the whole family.
model RefreshSession {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// Tenant the session is currently operating in (resolved from an ACTIVE membership).
  tenantId     String?   @map("tenant_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  /// SHA-256 of the opaque refresh token (hex).
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Set when this session was rotated; points at its successor.
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

/// Per-tenant preferences. One per tenant.
model TenantSettings {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @unique @map("tenant_id") @db.Uuid
  /// IANA time zone.
  timezone          String   @default("Asia/Kolkata") @db.VarChar(64)
  /// BCP 47 locale used for formatting.
  locale            String   @default("en-IN") @db.VarChar(16)
  /// ISO 4217 currency code.
  currency          String   @default("INR") @db.Char(3)
  /// Default conversation language for the future AI employee: en | hi | hinglish.
  preferredLanguage String   @default("en") @map("preferred_language") @db.VarChar(16)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("tenant_settings")
}

/// Append-only record of security- and business-relevant actions.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  /// Dotted action name, e.g. `member.role_changed`.
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.Uuid
  /// Non-sensitive context (never passwords, tokens or hashes).
  metadata   Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, action])
  @@index([actorId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 2A — inventory and leads
// Money is stored as whole rupees in BIGINT (no paise, no floating point).
// Rows are never hard-deleted: properties are ARCHIVED, leads are marked LOST.
// ---------------------------------------------------------------------------

enum PropertyType {
  APARTMENT
  INDEPENDENT_HOUSE
  VILLA
  BUILDER_FLOOR
  PLOT
  COMMERCIAL_OFFICE
  COMMERCIAL_SHOP
  OTHER
}

enum ListingType {
  SALE
  RENT
}

enum PropertyStatus {
  AVAILABLE
  ON_HOLD
  SOLD
  RENTED
  ARCHIVED
}

enum PossessionStatus {
  READY_TO_MOVE
  UNDER_CONSTRUCTION
}

enum LeadSource {
  WHATSAPP
  WEBSITE
  PHONE_CALL
  PORTAL
  SOCIAL_MEDIA
  REFERRAL
  WALK_IN
  MANUAL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  SITE_VISIT_SCHEDULED
  NEGOTIATION
  WON
  LOST
}

enum LeadTemperature {
  UNSCORED
  COLD
  WARM
  HOT
}

enum LeadPurpose {
  SELF_USE
  INVESTMENT
}

enum PurchaseTimeline {
  IMMEDIATE
  ONE_TO_THREE_MONTHS
  THREE_TO_SIX_MONTHS
  SIX_PLUS_MONTHS
  JUST_BROWSING
}

/// A listing in a business's inventory (flat, villa, plot, shop…). The AI employee will only
/// ever recommend rows from this table, never invent inventory.
model Property {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  title            String            @db.VarChar(160)
  /// Builder project / society name, if any.
  projectName      String?           @map("project_name") @db.VarChar(160)
  propertyType     PropertyType      @map("property_type")
  listingType      ListingType       @default(SALE) @map("listing_type")
  status           PropertyStatus    @default(AVAILABLE)
  /// Bedrooms (BHK). 0 = studio. Null for plots and commercial units.
  bedrooms         Int?              @db.SmallInt
  bathrooms        Int?              @db.SmallInt
  carpetAreaSqft   Int?              @map("carpet_area_sqft")
  /// Whole rupees. Sale price for SALE listings, monthly rent for RENT listings.
  price            BigInt
  locality         String?           @db.VarChar(120)
  city             String            @db.VarChar(100)
  state            String?           @db.VarChar(100)
  pincode          String?           @db.Char(6)
  possessionStatus PossessionStatus? @map("possession_status")
  possessionDate   DateTime?         @map("possession_date") @db.Date
  reraNumber       String?           @map("rera_number") @db.VarChar(60)
  amenities        String[]          @default([])
  description      String?           @db.Text
  createdById      String?           @map("created_by_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  siteVisits SiteVisit[]
  createdBy  User?       @relation("PropertyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, city, bedrooms])
  @@index([tenantId, price])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("properties")
}

/// A prospective buyer or tenant. `phone` is stored in E.164 and is unique per business, so the
/// same person messaging twice never creates two leads.
model Lead {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  name                String            @db.VarChar(120)
  /// E.164, e.g. +919876543210.
  phone               String            @db.VarChar(16)
  email               String?           @db.VarChar(254)
  source              LeadSource        @default(MANUAL)
  status              LeadStatus        @default(NEW)
  temperature         LeadTemperature   @default(UNSCORED)
  /// Whole rupees.
  budgetMin           BigInt?           @map("budget_min")
  budgetMax           BigInt?           @map("budget_max")
  preferredCity       String?           @map("preferred_city") @db.VarChar(100)
  preferredLocalities String[]          @default([]) @map("preferred_localities")
  preferredBedrooms   Int[]             @default([]) @map("preferred_bedrooms")
  purpose             LeadPurpose?
  timeline            PurchaseTimeline?
  needsHomeLoan       Boolean?          @map("needs_home_loan")
  /// Language the lead prefers to talk in: en | hi | hinglish.
  preferredLanguage   String?           @map("preferred_language") @db.VarChar(16)
  notes               String?           @db.Text
  /// Membership (not user) so assignment is always tied to a specific business.
  assignedToId        String?           @map("assigned_to_id") @db.Uuid
  lastContactedAt     DateTime?         @map("last_contacted_at") @db.Timestamptz(3)
  createdById         String?           @map("created_by_id") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignedTo    Membership?    @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  conversations Conversation[]
  siteVisits    SiteVisit[]

  @@unique([tenantId, phone])
  @@index([tenantId, status])
  @@index([tenantId, temperature])
  @@index([tenantId, assignedToId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// Phase 2B — conversations with the AI employee
// ---------------------------------------------------------------------------

enum ConversationChannel {
  /// Staff testing the AI from the dashboard.
  WEB_TEST
  WHATSAPP
  VOICE
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageRole {
  BUYER
  AI
  /// A human team member typing in the conversation.
  AGENT
  SYSTEM
}

model Conversation {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  leadId             String              @map("lead_id") @db.Uuid
  channel            ConversationChannel
  status             ConversationStatus  @default(OPEN)
  /// When false the AI stays silent and a human handles the conversation.
  aiEnabled          Boolean             @default(true) @map("ai_enabled")
  lastMessageAt      DateTime?           @map("last_message_at") @db.Timestamptz(3)
  /// Last message FROM the buyer. WhatsApp only allows free-form replies within 24 hours of it.
  lastBuyerMessageAt DateTime?           @map("last_buyer_message_at") @db.Timestamptz(3)
  createdById        String?             @map("created_by_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Restrict)
  createdBy User?     @relation("ConversationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  messages  Message[]

  @@index([tenantId, lastMessageAt(sort: Desc)])
  @@index([tenantId, leadId])
  @@map("conversations")
}

model Message {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  conversationId String                 @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String                 @db.Text
  /// AI replies: what was extracted, which properties were suggested, etc.
  metadata       Json?                  @db.JsonB
  /// AI replies only: model ID, token usage and latency, for cost tracking and evals.
  model          String?                @db.VarChar(80)
  inputTokens    Int?                   @map("input_tokens")
  outputTokens   Int?                   @map("output_tokens")
  latencyMs      Int?                   @map("latency_ms")
  /// Channel provider's message ID (WhatsApp `wamid`). Unique per business, so webhook retries are ignored.
  externalId     String?                @map("external_id") @db.VarChar(128)
  /// Outgoing channel messages only (AI and team replies on WhatsApp).
  deliveryStatus MessageDeliveryStatus? @map("delivery_status")
  /// Why delivery failed, in plain words. Never contains tokens.
  deliveryError  String?                @map("delivery_error") @db.VarChar(300)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalId])
  @@index([conversationId, createdAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Phase 3 — WhatsApp channel
// One WhatsApp Business phone number per business. Meta webhooks are routed to the
// business by `phone_number_id`. The access token is encrypted at rest (AES-256-GCM).
// ---------------------------------------------------------------------------

enum MessageDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsAppAccount {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @unique @map("tenant_id") @db.Uuid
  /// Meta's ID for the business phone number. Webhooks identify the business by it.
  phoneNumberId        String    @unique @map("phone_number_id") @db.VarChar(32)
  /// WhatsApp Business Account ID (needed later for templates).
  wabaId               String?   @map("waba_id") @db.VarChar(32)
  /// E.164 number buyers message, e.g. +919876543210.
  displayPhoneNumber   String    @map("display_phone_number") @db.VarChar(16)
  /// `v1:` + base64(iv | auth tag | ciphertext). Never returned by the API.
  accessTokenEncrypted String    @map("access_token_encrypted") @db.Text
  lastInboundAt        DateTime? @map("last_inbound_at") @db.Timestamptz(3)
  connectedById        String?   @map("connected_by_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  connectedBy User?  @relation("WhatsAppAccountConnectedBy", fields: [connectedById], references: [id], onDelete: SetNull)

  @@map("whatsapp_accounts")
}

// ---------------------------------------------------------------------------
// Phase 4 — site visits
// The AI collects a buyer's preferred day/time (REQUESTED); a team member confirms an exact
// slot (CONFIRMED), and the buyer is told on WhatsApp. Afterwards the visit is COMPLETED or
// NO_SHOW. Visits are never deleted: CANCELLED keeps the history.
// ---------------------------------------------------------------------------

enum SiteVisitStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model SiteVisit {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  leadId         String          @map("lead_id") @db.Uuid
  propertyId     String?         @map("property_id") @db.Uuid
  /// Conversation the request came from, if any.
  conversationId String?         @map("conversation_id") @db.Uuid
  status         SiteVisitStatus @default(REQUESTED)
  /// Exact slot. Null while REQUESTED without a confirmed time.
  scheduledAt    DateTime?       @map("scheduled_at") @db.Timestamptz(3)
  /// What the buyer asked for, in their words ("Saturday morning", "kal 5 baje").
  requestedSlot  String?         @map("requested_slot") @db.VarChar(120)
  notes          String?         @db.Text
  /// Team member who will show the property (a membership, like lead assignment).
  assignedToId   String?         @map("assigned_to_id") @db.Uuid
  /// Set when the reminder was sent, so it is sent exactly once.
  reminderSentAt DateTime?       @map("reminder_sent_at") @db.Timestamptz(3)
  createdById    String?         @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Restrict)
  property   Property?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignedTo Membership? @relation("SiteVisitAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("SiteVisitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, leadId])
  @@index([status, scheduledAt])
  @@map("site_visits")
}
